        <script><![CDATA[(function executeRule(current, previous) {

    var booking = new GlideRecord('x_2181317_smart_0_meeting_booking');

    booking.addQuery('meeting_room', current.meeting_room);
    booking.addQuery('status', 'confirmed');
    booking.query();

    while (booking.next()) {

        if (current.start_time < booking.end_time &&
            current.end_time > booking.start_time) {

            gs.addErrorMessage("This meeting room is already booked for the selected time.");

            current.setAbortAction(true);

            break;
        }
    }

})(current, previous);]]></script>
