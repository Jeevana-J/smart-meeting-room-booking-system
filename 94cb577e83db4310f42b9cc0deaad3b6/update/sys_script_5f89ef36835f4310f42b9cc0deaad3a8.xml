    if (room.get(current.meeting_room)) {

        if (parseInt(current.number_of_participants, 10) > parseInt(room.capacity, 10)) {

            gs.addErrorMessage("Number of participants exceeds room capacity.");

            current.setAbortAction(true);
        }
    }

